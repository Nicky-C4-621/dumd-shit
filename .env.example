# Copy to .env and fill in. Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Password the phone must send before the server will text for you.
# Strongly recommended once the server is reachable from the internet.
APP_TOKEN=pick-something-long

# The public URL Twilio uses to reach you (e.g. your ngrok URL).
# When set, inbound webhooks are verified with Twilio's signature.
PUBLIC_URL=

PORT=3000
# Use 0.0.0.0 to open the phone from other devices on your network
HOST=127.0.0.1
